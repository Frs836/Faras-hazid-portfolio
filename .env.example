# ============================================================
# ENV KEYS — copy to .env.local for local dev, set in Vercel
# for production. Server-only keys must NOT start with VITE_.
# ============================================================

# --- Supabase (public) ---
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# --- Supabase (server-only) ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Admin auth (SERVER-ONLY — never expose to the client) ---
# PIN used by POST /api/admin/verify (login gate). Default when unset: clay2026
ADMIN_PIN=change-this-pin
# Secret used to HMAC-sign the short-lived admin token. Rotate to revoke all tokens.
ADMIN_SECRET=change-this-long-random-secret

# --- Gemini auto-translate (SERVER-ONLY) ---
GEMINI_API_KEY=your-gemini-api-key